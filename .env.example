# rtsp-detection-v2 설정 예시. 설치 스크립트가 이 파일로 .env를 만듭니다.

# ── 포트 ──
# 비워 두면 설치할 때 이 PC에서 사용 가능한 포트를 고릅니다.
BACKEND_PORT=
FRONTEND_PORT=

# ── mediamtx ──
# API 주소는 컨테이너 사이에서 사용합니다. 아래 포트 4개는 설치할 때 채웁니다.
MEDIAMTX_API=http://mediamtx:9997
MEDIAMTX_API_PORT=
MEDIAMTX_RTSP_PORT=
MEDIAMTX_WEBRTC_PORT=
MEDIAMTX_ICE_UDP_PORT=
# 등록한 카메라의 영상 경로와 시청 권한에 사용하는 접두사입니다.
MEDIAMTX_PATH_PREFIX=rtsp_detection_v2
# 묻기: 다른 PC나 휴대폰에서 영상을 보려면 접속에 쓸 이 PC의 IP 주소를 입력하세요. 여러 개면 쉼표로 구분하고, 이 PC에서만 보면 Enter를 누르세요.
MEDIAMTX_WEBRTC_HOST=
# backend는 제어·송출용, viewer는 시청용입니다. 빈 비밀번호는 설치할 때 각각 생성합니다.
MEDIAMTX_BACKEND_USER=backend
MEDIAMTX_BACKEND_PASS=
MEDIAMTX_VIEWER_USER=viewer_rtsp_detection_v2
MEDIAMTX_VIEWER_PASS=

# ── 추론 ──
# YOLO26의 기본 모델과 검출 신뢰도 기준(0~1)입니다.
YOLO_DEFAULT_MODEL=yolo26n.pt
YOLO_CONF_THRESHOLD=0.5
# 비우면 GPU를 자동 감지하고, 없으면 CPU를 사용합니다. 직접 지정할 때는 cuda:0 또는 cpu를 입력하세요.
YOLO_DEVICE=
# 현재 버전에서 이 값은 엔진 선택에 쓰이지 않습니다. 실행할 엔진은 화면 상단 탭에서 선택하세요.
INFERENCE_ENGINE=yolo26

# ── 카메라 ──
# 등록 가능한 카메라의 최대 대수입니다(기본 16, 허용 범위 1~64).
MAX_IPCAMS=16
